# Copy to .env and edit. Everything runs with no changes using the mock LLM,
# the local embedder and the in-memory store.

# LLM: mock | openai | anthropic
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=

# Embeddings: local | openai
EMBEDDER=local

# Vector store: memory | pgvector | qdrant
VECTOR_STORE=memory
DATABASE_URL=            # e.g. postgresql://user:pass@localhost:5432/rag  (pgvector)
QDRANT_URL=              # e.g. http://localhost:6333                       (qdrant)

CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=5
MIN_CONFIDENCE=0.34
